# Venus Deployment Exclusions for Gateaux

# Dependencies
node_modules/
package-lock.json

# Source files (already compiled to dist/)
src/
index.html

# Development files
.git/
.gitignore
vite.config.js
package.json

# Build artifacts (Venus only needs dist/)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Generated art sources (not needed in production)
../generated_art/
../Art/

# Documentation
README.md
*.md

# Config files
.venusignore
game.config.json
